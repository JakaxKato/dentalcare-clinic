# ============================================================
# DentalCare — Production Environment Template
# ============================================================
# Copy to server/.env on the production host and fill in real values.
# Never commit .env. Rotate JWT_SECRET if it ever leaks.

NODE_ENV=production
APP_ENV=production
ALLOW_DEMO_ACCOUNTS=false
SEED_MODE=disabled
PORT=5000
# Number of trusted reverse proxies in front of Express.
# Use 1 for Caddy/nginx/Render/Railway. Increase only if you know the proxy chain.
TRUST_PROXY=1

# ----- Database (MongoDB Atlas or self-hosted) -----
# Dedicated production database; never point this at demo/test/local MongoDB.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/dentalcare_production?retryWrites=true&w=majority

# ----- Auth -----
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS_LONG
JWT_EXPIRES_IN=7d
# JWT_ISSUER=dentalcare

# Bcrypt cost (10..14). Higher = slower login but harder to brute force. Default 12.
BCRYPT_ROUNDS=12

# Max JSON body (defaults to 1mb).
JSON_BODY_LIMIT=1mb

# ----- CORS allowlist (comma-separated, no trailing slash) -----
CLIENT_URL=https://app.your-clinic.com,https://www.your-clinic.com

# Keep Swagger /api/docs CLOSED in production unless you have a public API.
ENABLE_SWAGGER=false

# ----- Cloudinary (required for image upload in production) -----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dentalcare

# ----- SMTP (required for password reset in production) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DentalCare <no-reply@your-clinic.com>"

# ----- Clinic identity (printed on invoice PDF + WhatsApp) -----
CLINIC_NAME=Klinik Gigi Anda
CLINIC_ADDRESS=Jl. Alamat Lengkap No. 1, Kota
CLINIC_PHONE_DISPLAY=0812-3456-7890

# ----- WhatsApp reminder (Fonnte) -----
FONNTE_TOKEN=
REMINDER_CRON=0 9 * * *
DISABLE_REMINDER=false

# ----- Midtrans (production keys) -----
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true
DP_PERCENT=30
DP_MIN_AMOUNT=25000
# Notification URL to configure in Midtrans dashboard:
# https://api.your-clinic.com/api/payments/notification
