PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/dentalcare

# Auth — JWT_SECRET MUST be at least 32 characters
JWT_SECRET=replace_me_with_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# Comma-separated allowlist of frontend origins for CORS
CLIENT_URL=http://localhost:5173

# Optional: Cloudinary (uncomment when using Cloudinary instead of local Multer storage)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=dentalcare

# Optional: SMTP for password reset emails (if absent, emails are printed to console in dev)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="DentalCare <no-reply@dentalcare.id>"

# Optional: Clinic identity (printed on invoice PDF + WhatsApp reminder)
# CLINIC_NAME=DentalCare Clinic
# CLINIC_ADDRESS=Jl. Contoh No.1, Jakarta
# CLINIC_PHONE_DISPLAY=0899-5242-631

# Optional: WhatsApp reminder H-1 (Fonnte). If FONNTE_TOKEN absent → console preview.
# Get token at https://fonnte.com after activating a device.
# FONNTE_TOKEN=
# REMINDER_CRON="0 9 * * *"        # default: every day 09:00 Asia/Jakarta
# DISABLE_REMINDER=false             # set true to skip arming the scheduler

# Optional: Midtrans Snap (payment gateway for DP)
# Get sandbox keys at https://dashboard.midtrans.com (Sandbox tab)
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false
# DP_PERCENT=30
# DP_MIN_AMOUNT=25000
#
# Configure the Midtrans HTTP notification URL to:
# https://your-api-domain.example/api/payments/notification
